API_HOST="http://localhost:8000"
API_PREFIX=/api
API_VERSION=v1

AMQP_ENABLED=true
EVENT_TYPES_TO_PROCESS=["created", "deleted", "updated", "unchanged"]
#--HARVESTER PLATFORM IDENTIFIERS--
HARVESTERS=["idref", "scanr", "hal", "openalex", "scopus"]

ES_ENABLED=true
ES_HOST="http://localhost"
ES_PORT=9200
ES_USER="elastic"
ES_PASSWORD="elastic"
ES_INDEXES='{"source_records": {"index_name": "source_records_index"}}'

ORG_REGISTRY_URL="http://localhost:3000"

EMAIL_UNPAYWALL = "test@test.com"

EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_URL="http://localhost:8080"
EMBEDDING_API_KEY=""
EMBEDDING_API_MODEL="your-model-name"
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_LOCAL_MODEL and EMBEDDING_DEVICE are used by the sentence_transformer provider
EMBEDDING_LOCAL_MODEL=""
EMBEDDING_DEVICE=cpu

TAXI_ENABLED=false
TAXI_API_URL="http://localhost:8000"
TAXI_TIMEOUT_SECONDS=30
# JSON list, priority order: the first language with a title or abstract is used
TAXI_LANGUAGES=["en", "fr"]
# minimum length of title + abstract (characters) below which Taxi is not called
TAXI_MIN_INPUT_LENGTH=25
# maximum number of source="crisalid" HAS_TOPIC edges per document
TAXI_MAX_TOPICS=30
# minimum cosine similarity; sent to Taxi and re-applied client-side
TAXI_SIMILARITY_THRESHOLD=0.6
# number of documents per Taxi request in the CLI recompute command
TAXI_BATCH_SIZE=50
# circuit breaker: after N consecutive failures, stop calling Taxi for M seconds
TAXI_MAX_CONSECUTIVE_FAILURES=5
TAXI_CIRCUIT_OPEN_SECONDS=300
